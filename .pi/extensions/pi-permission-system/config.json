{
  "permission": {
    "*": "allow",
    "path": {
      "/mnt/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"      
    },
   "write": {
      "*": "allow",
      ".pi/extensions/pi-permission-system/config.json": "deny"
   },
   "edit": {
      "*": "allow",
      ".pi/extensions/pi-permission-system/config.json": "deny"
   },
    "bash": {
      "*": "allow",
      "find": "allow",
      "find *": "allow",
      "nohup *": "allow",      
      "grep": "allow",          
      "grep *": "allow",      
      "xargs": "deny",
      "xargs *": "deny",
      "timeout": "deny",
      "timeout *": "deny"      
    }
  }
}

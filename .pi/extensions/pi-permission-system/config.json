{
  "permission": {
    "*": "allow",
    "path": {
      "/mnt/*": "deny"
    },
    "bash": {
      "*": "allow",
      "git tag": "deny",
      "git tag *": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git pull": "deny",
      "git pull *": "deny",
      "git cherry-pick": "deny",
      "git cherry-pick *": "deny",
      "git rm": "deny",
      "git rm *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git branch -f *": "deny",
      "git branch --force *": "deny",
      "git clean -f *": "deny",
      "git clean --force *": "deny"
    }
  }
}

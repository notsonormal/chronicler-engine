{
  "permission": {
    "*": "allow",
    "path": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"      
    },
   "write": {
      "*": "allow",
      ".pi/extensions/pi-permission-system/config.json": "deny"
   },
   "edit": {
      "*": "allow",
      ".pi/extensions/pi-permission-system/config.json": "deny"
   },
    "bash": {
      "*": "allow",
      "timeout": "deny",
      "timeout *": "deny"      
    }
  }
}

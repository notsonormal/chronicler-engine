{
  "permission": {
    "*": "allow",
    "path": {
      "/mnt/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"      
    },
   "write": {
      "*": "allow",
      ".pi/extensions/pi-permission-system/config.json": "deny"
   },
   "edit": {
      "*": "allow",
      ".pi/extensions/pi-permission-system/config.json": "deny"
   },
    "bash": {
      "*": "allow",
      "xargs": "deny",
      "xargs *": "deny",
      "find *": "deny",
      "timeout": "deny",
      "timeout *": "deny",      
      "git tag": "deny",
      "git tag *": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git cherry-pick": "deny",
      "git cherry-pick *": "deny",
      "git rm": "deny",
      "git rm *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git branch -f *": "deny",
      "git branch --force *": "deny",
      "git clean -f *": "deny",
      "git clean --force *": "deny",
      "git pull": "deny",
      "git pull *": "deny"  
    }
  }
}

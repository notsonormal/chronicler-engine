#!/bin/sh
# Git pre-commit hook: regenerate the docs and structure indexes, then stage
# them into the commit being made. Install with:
#   python scripts/install_git_hooks.py
#
# ENGINE_ROOT comes from git, not from $0. Git runs a linked worktree's hooks
# from the shared .git/hooks directory, so a $0-relative path resolves to the
# MAIN worktree while GIT_DIR/GIT_INDEX_FILE point at the linked one; the diff
# checks below would then compare one tree's files against the other's index
# and abort forever.

GENERATED_FILES="AGENTS.md tests/AGENTS.md docs/AGENTS.md docs/diataxis/reference/coding_standards/guardrails.md"

ENGINE_ROOT="$(git rev-parse --show-toplevel)" || exit 1
ORIG_DIR="$(pwd)"

cd "$ENGINE_ROOT" || exit 1

# The generated files are partly hand-written — AGENTS.md and docs/AGENTS.md
# carry prose beside their generated blocks. If one already has unstaged
# changes, the generators are not its only writer, so the regenerated output
# cannot be staged safely without sweeping that prose into the commit.
for f in $GENERATED_FILES; do
    if ! git diff --quiet -- "$f"; then
        echo ""
        echo "$f has unstaged changes, so this hook cannot safely re-stage it."
        echo "Stage or stash your edits first, then commit again:"
        echo "  git add $f"
        cd "$ORIG_DIR"
        exit 1
    fi
done

fail() {
    echo "" >&2
    echo "$1" >&2
    cd "$ORIG_DIR"
    exit 1
}

# A generator that fails can leave a half-written file, which must not be
# staged — hence the explicit exit-code checks.
python "scripts/generate_docs_index.py" || fail "docs index generation failed"
python "scripts/generate_guardrails_doc.py" || fail "guardrails doc generation failed"
python "scripts/generate_structure_index.py" || fail "structure index generation failed"
python "scripts/generate_tests_structure_index.py" || fail "tests structure index generation failed"

# Stage the regenerated indexes into the in-progress commit, so the author does
# not have to commit twice.
git add -- $GENERATED_FILES || fail "staging the regenerated indexes failed"

cd "$ORIG_DIR"
exit 0

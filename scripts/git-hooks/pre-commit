#!/bin/sh
# Git pre-commit hook: regenerate the docs and structure indexes, then stage
# them into the commit being made. Install with:
#   python scripts/install_git_hooks.py
#
# ENGINE_ROOT comes from git, not from $0. Git runs a linked worktree's hooks
# from the shared .git/hooks directory, so a $0-relative path resolves to the
# MAIN worktree while GIT_DIR/GIT_INDEX_FILE point at the linked one. The helper
# resolves the repository the same way, so a linked worktree regenerates its own
# files against its own index.
#
# The helper refuses when one of the four files has hand-written prose the
# commit would sweep in, and it restores the files on every abort after the
# generators have started — a failed run leaves the worktree as it was found.

ENGINE_ROOT="$(git rev-parse --show-toplevel)" || exit 1
ORIG_DIR="$(pwd)"

cd "$ENGINE_ROOT" || exit 1

python "scripts/precommit_regenerate.py"
status=$?

cd "$ORIG_DIR"
exit "$status"

    #[test]
    fn test_state_patch_merge_destination_second_used() {
        let patch1 = StatePatch::Scene {
            npc_ids: vec![],
            movement_destination: None,
            confidence: Confidence::High,
        };
        let patch2 = StatePatch::Scene {
            npc_ids: vec![],
            movement_destination: Some("room2".into()),
            confidence: Confidence::High,
        };
        let merged = patch1.merge(patch2);
        let StatePatch::Scene {
        } = merged
            assert_eq!(movement_destination, Some("room2".into()));
            panic!("Merged patch is not Scene variant");
        }
    }

